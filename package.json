{
  "name": "elbero",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @elbero/mobile",
    "dev:api": "npm run start:dev --workspace @elbero/api",
    "research:t02": "node tools/kric/fetch-t02-samples.mjs",
    "research:line-sync": "node tools/kric/audit-line-sync.mjs",
    "verification:line-5": "node tools/kric/update-line5-accessibility-guidance.mjs",
    "verification:t06": "node tools/validation/validate-t06-normalized-sample.mjs",
    "verification:t07": "npm run build --workspace @elbero/contracts && node tools/validation/validate-t07-contract.mjs",
    "verification:t10": "npm run build --workspace @elbero/contracts && node tools/validation/build-t10-data-package.mjs",
    "research:elevator-status": "node tools/seoul/fetch-elevator-status.mjs",
    "build": "npm run build --workspace @elbero/contracts && npm run build --workspace @elbero/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
